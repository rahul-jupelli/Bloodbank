    }

    def mvnHome = tool name: 'Maven3', type: 'hudson.tasks.Maven$MavenInstallation'
    def mvn = "${mvnHome}/bin/mvn"

    stage('Clean') {
        sh "${mvn} clean"
    }
    stage('Compile') {
        sh "${mvn} compile"
    }
    stage('Test') {
        sh "${mvn} test"
    }
    stage('Package') {
        sh "${mvn} package"
    }
    stage('Archive') {
        archiveArtifacts artifacts: '**/target/*.war, **/target/*.jar', fingerprint: true
    }
}

For Windows agents, use `bat` instead of `sh` and `${mvnHome}\\bin\\mvn.cmd`. Replace the repository URL, branch and Maven tool name with the values configured in your Jenkins instance. For a repository containing the pom.xml in a subfolder, wrap Maven commands in `dir('actual-folder-name') { ... }`.

GitHub push trigger:
- In a Declarative Pipeline, a `triggers { githubPush() }` block can be used when the required GitHub integration plugin is installed.
- For Scripted Pipeline, configure the job's build trigger in Jenkins job configuration or use the appropriate plugin-supported properties syntax.
- Configure the GitHub webhook to point to `https://<public-or-ngrok-host>/github-webhook/`. A local Jenkins server is not directly reachable from GitHub without a public endpoint/tunnel.

